{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>antoine-bouteiller/renovate'],
  packageRules: [
    {
      description: 'Oxlint pins, bumped by hand to a version @effect/tsgo ships a patched build for',
      enabled: false,
      matchPackageNames: ['oxlint', '@oxlint/plugins', 'oxlint-tsgolint'],
    },
  ],
}
