{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>antoine-bouteiller/renovate'],
  packageRules: [
    {
      description: 'Oxlint dev pins (pinned to the oldest oxlint in peerDependencies)',
      enabled: false,
      matchDepTypes: ['devDependencies'],
      matchPackageNames: ['oxlint', '@oxlint/plugins', 'oxlint-tsgolint'],
    },
  ],
}
